# GEMINI_API_KEY: Required for Yojana Mitra AI Assistant (Gemini API calls).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used to sign authentication tokens.
JWT_SECRET="change-me-in-production"

# SQLITE_DB_PATH: Optional override path for the SQLite database file.
SQLITE_DB_PATH="./data/yojana_sarthi.db"

# ADMIN_SEED_PASSWORD: Optional initial password for the seeded admin account.
ADMIN_SEED_PASSWORD="Admin@Yojana2026"
